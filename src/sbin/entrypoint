#!/bin/sh
set -eu

export > /env 2>/dev/null || true

php-fpm --nodaemonize &
PHP_PID=$!

nginx -g 'daemon off;' &
NGINX_PID=$!

shutdown() {
    trap '' TERM INT
    nginx -s quit 2>/dev/null || true
    kill -QUIT "$PHP_PID" 2>/dev/null || true
    wait "$NGINX_PID" 2>/dev/null || true
    wait "$PHP_PID" 2>/dev/null || true
    exit "${1:-0}"
}

trap 'shutdown 0' TERM INT

while kill -0 "$NGINX_PID" 2>/dev/null && kill -0 "$PHP_PID" 2>/dev/null; do
    sleep 1 &
    wait $! 2>/dev/null || true
done

if ! kill -0 "$NGINX_PID" 2>/dev/null; then
    echo "nginx exited unexpectedly" >&2
else
    echo "php-fpm exited unexpectedly" >&2
fi

shutdown 1
